		{
			"name": "[concat(parameters('factoryName'), '/AirPollutionDataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "apguptads562airpollutionAzureBlobsinkJson1",
								"type": "DatasetReference"
							},
							"name": "AirPollutionSource1"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "apguptads562airpollutionAzureBlobStorage1",
								"type": "LinkedServiceReference"
							},
							"name": "airpollutionsilversink"
						}
					],
					"transformations": [
						{
							"name": "airpollutionflatten"
						},
						{
							"name": "fixingtimestampairpollution"
						},
						{
							"name": "airpollutionfilter"
						},
						{
							"name": "additionalcolumns"
						},
						{
							"name": "droppingcolumns"
						}
					],
					"scriptLines": [
						"source(output(",
						"          coord as (lat as double, lon as double),",
						"          list as (components as (co as double, nh3 as double, no as double, no2 as double, o3 as double, pm10 as double, pm2_5 as double, so2 as double), dt as integer, main as (aqi as short))[]",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     documentForm: 'documentPerLine') ~> AirPollutionSource1",
						"AirPollutionSource1 foldDown(unroll(list, list),",
						"     mapColumn(",
						"          lat = coord.lat,",
						"          lon = coord.lon,",
						"          co = list.components.co,",
						"          nh3 = list.components.nh3,",
						"          no = list.components.no,",
						"          no2 = list.components.no2,",
						"          o3 = list.components.o3,",
						"          pm10 = list.components.pm10,",
						"          pm2_5 = list.components.pm2_5,",
						"          so2 = list.components.so2,",
						"          timestamp = list.dt,",
						"          aqi = list.main.aqi",
						"     ),",
						"     skipDuplicateMapInputs: false,",
						"     skipDuplicateMapOutputs: false) ~> airpollutionflatten",
						"airpollutionflatten derive(corrected_timestamp = iif(length(toString(timestamp)) == 10, toInteger(timestamp), toInteger(null())),",
						"          location = \"Boston\") ~> fixingtimestampairpollution",
						"fixingtimestampairpollution filter(!isNull(corrected_timestamp) && !isNull(aqi)) ~> airpollutionfilter",
						"airpollutionfilter derive(date_time = toTimestamp(toLong(corrected_timestamp) * 1000),",
						"          id = concat(location,toString(timestamp)),",
						"          co = round(co, 2)",
						",",
						"          nh3 = round(nh3, 2),",
						"          no = round(no, 2),",
						"          no2 = round(no2, 2),",
						"          o3 = round(o3, 2),",
						"          pm10 = round(pm10, 2),",
						"          pm2_5 = round(pm2_5, 2),",
						"          so2 = round(so2, 2)) ~> additionalcolumns",
						"additionalcolumns select(mapColumn(",
						"          id,",
						"          lat,",
						"          lon,",
						"          co,",
						"          nh3,",
						"          no,",
						"          no2,",
						"          o3,",
						"          pm10,",
						"          pm2_5,",
						"          so2,",
						"          aqi,",
						"          corrected_timestamp,",
						"          location,",
						"          date_time",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> droppingcolumns",
						"droppingcolumns sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     container: '562hw',",
						"     folderPath: 'Silver/AirPollution',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> airpollutionsilversink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/apguptads562airpollutionAzureBlobsinkJson1')]",
				"[concat(variables('factoryId'), '/linkedServices/apguptads562airpollutionAzureBlobStorage1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/WeatherDataFlow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "apguptads562weatherpredictionsinkJson1",
								"type": "DatasetReference"
							},
							"name": "WeatherDataSource"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "apguptads562weatherpredictionAzureBlobStorage1",
								"type": "LinkedServiceReference"
							},
							"name": "weathersilversink"
						}
					],
					"transformations": [
						{
							"name": "weatherpredictionflatten1"
						},
						{
							"name": "fixingtimestampweather"
						},
						{
							"name": "weatherdatafilter"
						},
						{
							"name": "addingnewcolumnsweather"
						},
						{
							"name": "weatherdataselection"
						}
					],
					"scriptLines": [
						"source(output(",
						"          calctime as double,",
						"          city_id as boolean,",
						"          cnt as short,",
						"          cod as short,",
						"          list as (clouds as (all as short), dt as integer, main as (feels_like as double, humidity as short, pressure as short, temp as double, temp_max as double, temp_min as double), rain as ({1h} as double), snow as ({1h} as double), weather as (description as string, icon as string, id as short, main as string)[], wind as (deg as short, gust as double, speed as double))[],",
						"          message as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     documentForm: 'documentPerLine') ~> WeatherDataSource",
						"WeatherDataSource foldDown(unrollMultiple(list,list.weather),",
						"     mapColumn(",
						"          calctime,",
						"          city_id,",
						"          cnt,",
						"          cod,",
						"          message,",
						"          clouds_all = list.clouds.all,",
						"          timestamp = list.dt,",
						"          feels_like = list.main.feels_like,",
						"          humidity = list.main.humidity,",
						"          pressure = list.main.pressure,",
						"          temp = list.main.temp,",
						"          temp_max = list.main.temp_max,",
						"          temp_min = list.main.temp_min,",
