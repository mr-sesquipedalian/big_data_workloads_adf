{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "apguptads562datafactory"
		},
		"GitHub Apgupta_credential": {
			"type": "secureString",
			"metadata": "Secure string for 'credential' of 'GitHub Apgupta'"
		},
		"apguptads562airpollutionAzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'apguptads562airpollutionAzureBlobStorage1'"
		},
		"GitHub Apgupta_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "mr-sesquipedalian"
		},
		"apguptads562airpollutionRestService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "http://api.openweathermap.org/"
		},
		"apguptads562airpollutionRestService1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "http://api.openweathermap.org/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "apguptads562datafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"GitHub Apgupta_credential": {
						"value": "[parameters('GitHub Apgupta_credential')]"
					},
					"apguptads562airpollutionAzureBlobStorage1_connectionString": {
						"value": "[parameters('apguptads562airpollutionAzureBlobStorage1_connectionString')]"
					},
					"GitHub Apgupta_properties_typeProperties_username": {
						"value": "[parameters('GitHub Apgupta_properties_typeProperties_username')]"
					},
					"apguptads562airpollutionRestService_properties_typeProperties_url": {
						"value": "[parameters('apguptads562airpollutionRestService_properties_typeProperties_url')]"
					},
					"apguptads562airpollutionRestService1_properties_typeProperties_url": {
						"value": "[parameters('apguptads562airpollutionRestService1_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}