{
	"name": "WeatherDataFlow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "apguptads562weatherpredictionsinkJson1",
						"type": "DatasetReference"
					},
					"name": "WeatherDataSource"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "apguptads562weatherpredictionAzureBlobStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "weathersilversink"
				}
			],
			"transformations": [
				{
					"name": "weatherpredictionflatten1"
				},
				{
					"name": "fixingtimestampweather"
				},
				{
					"name": "weatherdatafilter"
				},
				{
					"name": "addingnewcolumnsweather"
				},
				{
					"name": "weatherdataselection"
				}
			],
			"scriptLines": [
				"source(output(",
				"          calctime as double,",
				"          city_id as boolean,",
				"          cnt as short,",
				"          cod as short,",
				"          list as (clouds as (all as short), dt as integer, main as (feels_like as double, humidity as short, pressure as short, temp as double, temp_max as double, temp_min as double), rain as ({1h} as double), snow as ({1h} as double), weather as (description as string, icon as string, id as short, main as string)[], wind as (deg as short, gust as double, speed as double))[],",
				"          message as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> WeatherDataSource",
				"WeatherDataSource foldDown(unrollMultiple(list,list.weather),",
				"     mapColumn(",
				"          calctime,",
				"          city_id,",
				"          cnt,",
				"          cod,",
				"          message,",
				"          clouds_all = list.clouds.all,",
				"          timestamp = list.dt,",
				"          feels_like = list.main.feels_like,",
				"          humidity = list.main.humidity,",
				"          pressure = list.main.pressure,",
				"          temp = list.main.temp,",
				"          temp_max = list.main.temp_max,",
				"          temp_min = list.main.temp_min,",
				"          rain_1h = list.rain.{1h},",
				"          snow_1h = list.snow.{1h},",
				"          weather_description = list.weather.description,",
				"          weather_icon = list.weather.icon,",
				"          weather_id = list.weather.id,",
				"          weather_main = list.weather.main,",
				"          wind_deg = list.wind.deg,",
				"          wind_gust = list.wind.gust,",
				"          wind_speed = list.wind.speed",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> weatherpredictionflatten1",
				"weatherpredictionflatten1 derive(corrected_timestamp = iif(length(toString(timestamp)) == 10, toInteger(timestamp), toInteger(null())),",
				"          location = \"Boston\") ~> fixingtimestampweather",
				"fixingtimestampweather filter(!isNull(corrected_timestamp) ) ~> weatherdatafilter",
				"weatherdatafilter derive(date_time = toTimestamp(toLong(corrected_timestamp) * 1000),",
				"          id = concat(location,toString(timestamp)),",
				"          temp_C = round(temp-273.15,2),",
				"          feels_like_C = round(feels_like-273.15,2),",
				"          temp_min_C = round(temp_min-273.15,2),",
				"          temp_max_C = round(temp_max-273.15,2),",
				"          feels_like_F = round((((feels_like - 273.15) * 9/5) + 32),2),",
				"          temp_min_F = round((((temp_min - 273.15) * 9/5) + 32),2),",
				"          temp_max_F = round((((temp_max - 273.15) * 9/5) + 32),2),",
				"          lat = 42.3601,",
				"          lon = -71.0589,",
				"          weather_id_value = toInteger(weather_id),",
				"          rain_1h = iif(isNull(rain_1h), toFloat(0.0), toFloat(rain_1h))) ~> addingnewcolumnsweather",
				"addingnewcolumnsweather select(mapColumn(",
				"          id,",
				"          clouds_all,",
				"          humidity,",
				"          pressure,",
				"          feels_like_k = feels_like,",
				"          temp_k = temp,",
				"          temp_max_k = temp_max,",
				"          temp_min_k = temp_min,",
				"          rain_1h,",
				"          snow_1h,",
				"          weather_description,",
				"          weather_icon,",
				"          weather_id,",
				"          wind_deg,",
				"          wind_gust,",
				"          wind_speed,",
				"          corrected_timestamp,",
				"          location,",
				"          date_time,",
				"          temp_C,",
				"          feels_like_C,",
				"          temp_min_C,",
				"          temp_max_C,",
				"          feels_like_F,",
				"          temp_min_F,",
				"          temp_max_F,",
				"          lat,",
				"          lon,",
				"          weather_id_value",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> weatherdataselection",
				"weatherdataselection sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     container: '562hw',",
				"     folderPath: 'Silver/WeatherPrediction',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> weathersilversink"
			]
		}
	}
}