{
	"name": "PreprocessAirPollutionData",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "apguptads562airpollutionAzureBlobsinkJson1",
						"type": "DatasetReference"
					},
					"name": "apguptaairpollutionsource1",
					"description": "Import data from apguptaairpollutionsource1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "airpollutionflatten1"
				},
				{
					"name": "airpollutionderivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          coord as (lon as double, lat as double),",
				"          list as (main as (aqi as integer), components as (co as double, no as double, no2 as double, o3 as double, so2 as double, pm2_5 as double, pm10 as double, nh3 as double), dt as integer)[]",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine',",
				"     wildcardPaths:['**/*.json']) ~> apguptaairpollutionsource1",
				"apguptaairpollutionsource1 foldDown(unroll(),",
				"     mapColumn(",
				"          datetime = list.dt,",
				"          lat = coord.lat,",
				"          lon = coord.lon,",
				"          co = list.components.co,",
				"          nh3 = list.components.nh3,",
				"          no = list.components.no,",
				"          no2 = list.components.no2,",
				"          o3 = list.components.o3,",
				"          pm10 = list.components.pm10,",
				"          pm2_5 = list.components.pm2_5,",
				"          so2 = list.components.so2,",
				"          aqi = list.main.aqi",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> airpollutionflatten1",
				"airpollutionflatten1 derive(corrected_timestamp = @iif(isNull(timestamp), null, iif(length(string(toInteger(timestamp))) == 10, timestamp, null))) ~> airpollutionderivedColumn1"
			]
		}
	}
}