{
	"name": "PreprocessAirPollutionData",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "apguptads562airpollutionAzureBlobsinkJson1",
						"type": "DatasetReference"
					},
					"name": "apguptaairpollutionsource1",
					"description": "Import data from"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "airpollutionflatten1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          calctime as double,",
				"          city_id as boolean,",
				"          cnt as short,",
				"          cod as short,",
				"          coord as (lat as double, lon as double),",
				"          list as (clouds as (all as short), components as (co as double, nh3 as double, no as double, no2 as double, o3 as double, pm10 as double, pm2_5 as double, so2 as double), dt as integer, main as (aqi as short, feels_like as double, humidity as short, pressure as short, temp as double, temp_max as double, temp_min as double), rain as ({1h} as double), snow as ({1h} as double), weather as (description as string, icon as string, id as short, main as string)[], wind as (deg as short, gust as double, speed as double))[],",
				"          message as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine',",
				"     wildcardPaths:['**/*.json']) ~> apguptaairpollutionsource1",
				"apguptaairpollutionsource1 foldDown(unroll(),",
				"     mapColumn(",
				"          calctime,",
				"          city_id,",
				"          cnt,",
				"          message,",
				"          clouds_all = list.clouds.all,",
				"          cod,",
				"          timestamp = list.dt,",
				"          feels_like = list.main.feels_like,",
				"          humidity = list.main.humidity,",
				"          pressure = list.main.pressure,",
				"          temp = list.main.temp,",
				"          temp_max = list.main.temp_max,",
				"          temp_min = list.main.temp_min,",
				"          weather_description = list.weather.description,",
				"          weather_icon = list.weather.icon,",
				"          weather_id = list.weather.id,",
				"          weather_main = list.weather.main,",
				"          wind_deg = list.wind.deg,",
				"          wind_gust = list.wind.gust,",
				"          wind_speed = list.wind.speed,",
				"          rain_1h = list.rain.{1h}",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> airpollutionflatten1"
			]
		}
	}
}